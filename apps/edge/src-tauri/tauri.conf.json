{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rampage Edge",
  "version": "0.2.1",
  "identifier": "ai.obtuse.rampage.edge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Rampage Edge",
      "width": 480,
      "height": 860,
      "minWidth": 320,
      "minHeight": 600
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Foreground-safe Rampage compute contributor.",
    "android": { "minSdkVersion": 26 },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "frameworks": ["SystemConfiguration"]
    }
  }
}
