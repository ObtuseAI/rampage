{
  "name": "rampage",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "desktop:dev": "pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm --dir apps/desktop build",
    "desktop:test": "pnpm --dir apps/desktop test",
    "sdk:build": "pnpm --dir packages/sdk-ts build",
    "sdk:test": "pnpm --dir packages/sdk-ts test",
    "check": "pnpm desktop:test && pnpm desktop:build && pnpm sdk:test && pnpm sdk:build"
  }
}
